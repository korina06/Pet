# ======================================================================
# 环境变量模板
#
# 用法：复制为 .env 并填入真实值。.env 不会被提交到 Git。
#     cp .env.example .env              # Linux / macOS
#     Copy-Item .env.example .env       # Windows PowerShell
#
# 或者直接跑 scripts\start.ps1，它会帮你复制并安装依赖。
#
# 注意：这个文件必须是**纯 KEY=VALUE + # 注释**。
# 曾经这里有一段三引号 docstring（Python 模块的写法）—— python-dotenv 虽然能容忍，
# 但每次启动都会打印 "could not parse statement"，还会多出两个异常 key。
# 现在由 tests/test_env_example.py 守着：非注释行必须是 KEY=VALUE。
# ======================================================================

# ---------- 预算 ----------
# 聊天一轮的服务端总预算（秒）。桌宠聊天只有 1-2 步，90 秒足够；
# 它的作用是在"模型网关每一步都磨满超时"时兜住，不然最坏要挂 4 分钟。
CHAT_DEADLINE_SECONDS=90

# ---------- 人设 ----------
# 桌宠怎么称呼你（第 143 步）：哥哥 / 姐姐 / 你的昵称
PET_ADDRESS=哥哥

# ---------- LLM ----------
# DeepSeek 开放平台：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY =
# 允许覆盖，方便切换到兼容 OpenAI 协议的其它模型服务
DEEPSEEK_BASE_URL = https://api.deepseek.com
DEEPSEEK_MODEL = deepseek-chat

# 备用模型（第 98 步）：界面上「模型」开关可以在它们之间切换。
# 智谱 GLM：https://open.bigmodel.cn （v4 接口 OpenAI 兼容，实测工具调用与流式都通）
# glm-4-flash 是免费档，够桌宠用；想更聪明可改 glm-4-air / glm-4-plus。
GLM_API_KEY =
GLM_BASE_URL = https://open.bigmodel.cn/api/paas/v4
GLM_MODEL = glm-4-flash
# 向量召回用的嵌入模型（第 182 步）。没有 GLM_API_KEY 时整条向量路自动关闭；
# 想强制回到纯字面检索，把 EMBEDDING_ENABLED 设 0。
GLM_EMBEDDING_MODEL = embedding-3
# 默认 1（开启）：向量只做召回（top-10），要不要由**模型裁决**决定，
# 所以"库里没有"能被正确说成没有（见 docs/DECISIONS.md 第 188 步）。
# 想完全回到纯字面检索就设 0；复现实验：python scripts/eval_retrieval.py --vectors
EMBEDDING_ENABLED = 1

# MiMo：目前只有 key，接口地址与模型名留空 —— 界面上会**列出但不可选**。
# 以后填上这两项就能用，不用改代码。
MIMO_API_KEY =
MIMO_BASE_URL =
MIMO_MODEL =

# ---------- 和风天气（查天气）----------
# 控制台：https://console.qweather.com
#
# 注意：新版和风天气要求使用「账号专属 API Host」，公共地址
# api.qweather.com / devapi.qweather.com 自 2026 年起逐步停止服务。
# 在 控制台-设置 页面查看你的 Host，形如：
#     HEFENG_API_HOST = h2a9cf3mhs.xy.qweatherapi.com
# 只需填主机名，不要带 https:// 和结尾斜杠。
HEFENG_API_HOST =
HEFENG_API_KEY =

# ---------- 高德地图（查附近好玩的地方）----------
# 控制台：https://console.amap.com/dev/key
#
# 关键：创建 Key 时【服务平台】必须选「Web 服务」，
# 选成「Web端(JS API)」或「Android」时，本项目的调用会直接报 key 无效。
#
# 免费额度：个人认证开发者「基础搜索服务」5,000 次/月。
GAODE_API_KEY =

# ---------- 高德：行程地图（第 224 步，可选）----------
# 上面那把是「Web 服务」Key，**不能**拿来当 JS API 用；地图要另外两样：
#   1. 控制台新建一把 Key，服务平台选「Web端(JS API)」→ 填 GAODE_JS_KEY
#   2. 同一个应用里的「安全密钥」→ 填 GAODE_JS_SECURITY_CODE（2021-12 之后申请的 Key 必须有）
#
# 两样缺一个，地图卡片就不出现（其余功能不受影响）。
# 安全密钥只在服务端用（前端通过 /_AMapService 转发），不会写进网页。
GAODE_JS_KEY =
GAODE_JS_SECURITY_CODE =

# ---------- Unsplash（出行计划里的景点配图）----------
# 控制台：https://unsplash.com/oauth/applications（登录后新建 Application）
#
# 关键：应用页面上有「Access Key」和「Secret Key」两把，长得几乎一样。
# 这里必须填 **Access Key**；填成 Secret Key 会一律返回
#   401 {"errors":["OAuth error: The access token is invalid"]}
# （这个坑已经踩过一次，排查了很久。）
#
# 限制：Demo 应用每小时 50 次搜索请求。本项目对同一关键词做 24 小时缓存，
# 正常点几次出行不会撞到限额，但连续大量查询仍可能触发。
UNSPLASH_API_KEY =

#
# 关键：key 形如 `tvly-xxxxxxxx`，认证走请求头
#     Authorization: Bearer <key>
# 填错/缺失时后端会返回一句可读的中文提示，而不是让窗口一片空白。
#
# 额度（官方文档，2026 年核过）：免费 1000 credits/月；
# basic 搜索 1 credit/次、advanced 搜索 2 credits/次。
# 本项目只用 basic，且**每次生成固定 4 次搜索**（与要几天无关），
# 所以一次生成约 4 credits —— 免费额度大约够 250 次生成。

# ---------- 其它可选配置 ----------
# 桌宠默认查询的城市经纬度（不填则由 Agent 向用户询问）
DEFAULT_CITY_LAT = 39.92
DEFAULT_CITY_LON = 116.41

# ---- SerpAPI（食谱：上传图片识菜，走 Google Lens，第 60 步）----
# 控制台：https://serpapi.com/manage-api-key
SERPAPI_API_KEY =

# ---- 业务库路径（留空则用 data/pet.db）----
PET_DB_PATH =

# ---- 外部 MCP 服务器（第 215 / 217 步）：车次 / 黄历 / 航班 / 搜索等 ----
# 12306 车次：填了就多一个 search_trains 工具，留空就是关闭（出行窗口照旧）。
# 地址以 /sse 结尾走 SSE 传输，其余走 streamable HTTP。
# 托管的服务通常要令牌；自托管的一般不用，所以默认空。
MCP_12306_URL =
MCP_12306_TIMEOUT_SECONDS = 20
MCP_12306_TOKEN =
# 同一台服务器上额外暴露的工具（逗号分隔）。默认只要票价和「当前时间/相对日期」，
# 它们能让模型把「下周六」算成具体日期、在比较方案时报出票价。
#     all  = 它声明的工具全给（会诱导模型多用中间步骤工具，不推荐）
#     none = 只留手写的 search_trains
MCP_12306_EXTRA_TOOLS = query-ticket-price,get-current-time

# 其余 MCP 服务器（第 217 步）：一段 JSON 数组，接一台加一项，不用改代码。
# name 会变成工具名前缀（bazi_query_almanac），只允许字母/数字/下划线/连字符。
# 可选字段：token / timeout_seconds / max_chars / tools（只暴露这几个远端工具）。
#     MCP_SERVERS = [{"name":"bazi","url":"https://xxxx/sse","token":"sk-…"}]
#     MCP_SERVERS = [{"name":"bazi","url":"…","tools":["query_almanac","lucky_day"]},
#                    {"name":"flight","url":"…"}]  → 一行写完（JSON 里不能换行）
# 改完地址或换了服务器，**必须重跑一次**（否则模型看不到新工具）：
#     python scripts\mcp_remote_probe.py            # 抓清单写缓存
#     python scripts\mcp_remote_probe.py --show     # 只看缓存里有什么
# 工具清单缓存在 data/mcp_tools.json（含服务器地址与工具名，不进仓库）。
MCP_SERVERS =
MCP_TOOLS_CACHE = data/mcp_tools.json

# ---- 黄历（第 221 步）----
# 填 MCP_SERVERS 里管黄历那台的 name（ModelScope 的 Bazi Server 就是 bazi）。
# 填了之后，那台的 getChineseCalendar 会被换成 search_almanac：
# 按 start_date/end_date 一次查完一段日期，每天只留宜/忌/冲煞/节气。
# 留空 = 不接黄历（其它外部工具照旧）。
MCP_ALMANAC_SERVER =

# ---- 联网搜索（第 222 步）----
# 填 MCP_SERVERS 里管搜索那台的 name（ModelScope 的 Bing Search Server 一般叫 bing）。
# 填了之后，那台的 bing_search 会被换成 search_web（只回标题/摘要/链接，默认 5 条），
# 同台的 crawl_webpage（抓正文）会被摘掉：实测抓百度百科 403，能抓到的整页太大。
# 留空 = 不接联网搜索（其它外部工具照旧）。
MCP_WEB_SEARCH_SERVER =

# ---- 安全（第 192 步 / 评价15 T0-1）----
# 服务只接受这些 Host 头（逗号分隔），默认本机回环，挡 DNS rebinding。
# 平时不要改；将来要把服务绑到 0.0.0.0 给手机/平板用时，把那个 IP 加进来。
ALLOWED_HOSTS = 127.0.0.1,localhost,[::1],testserver

# ---- 最小可交付性（第 251 步）----
# 多用户模式：name:token 逗号分隔。留空 = 关闭（本机模式，行为与以前完全一致）。
# 配了之后 /api/* 都要 Authorization: Bearer <token>，会话按 owner 隔离。
# 格式错会直接启动失败 —— 鉴权配置写错不该悄悄退化成「没有鉴权」。
AUTH_TOKENS =
# 每个 token 每 60 秒最多多少个请求；0 = 不限（单进程内存计数）
AUTH_RATE_LIMIT = 0
# 允许的浏览器 Origin（逗号分隔）；空 = 不校验。带 Origin 且不在列表 → 403。
AUTH_ALLOWED_ORIGINS =

# ---- 运行调优（都可以不填，用默认值）----
# 单轮对话里允许的最大工具调用轮数（防死循环）
AGENT_MAX_STEPS = 4

# 第 112 步：token 软预算（三件不同的东西，别互相替代）
# MAX_OUTPUT_TOKENS：单次输出上限（食谱实测 completion 59–147，1000 很宽裕）
# TURN_TOKEN_BUDGET：一轮（Agent 多步 + 工具结果）的软预算，0 = 不限
# DAILY_TOKEN_WARN：单日用量告警阈值，0 = 关闭；**只告警不拒绝**
# 这两个阈值别拍脑袋：先跑 `python scripts/usage_report.py --days 7 --stats`，
# 它会按账本里的真实分布（P50/P95/最大值）打印建议值（第 210 步）。
MAX_OUTPUT_TOKENS = 1000
TURN_TOKEN_BUDGET = 20000
# 出行聊天自己的单轮 token 预算（第 256 步）：一轮要 4~6 次调用，
# 实测 4 次已 25,952 token，共用 20K 会在第 5 步前停下。0 = 不限。
TRIP_CHAT_TURN_TOKEN_BUDGET = 60000
DAILY_TOKEN_WARN = 0
# 每个会话保留的历史消息条数
SESSION_MAX_MESSAGES = 40
# 一次行程生成的**总预算**（秒）；超时会返回 504 并说明原因
TRIP_DEADLINE_SECONDS = 25
# 出行对话（第 216 步）里模型最多走几步；走满就收尾，防止来回查个没完
TRIP_CHAT_MAX_STEPS = 6
# 出行对话一轮的总预算（秒）；超时会收尾并说明，不会吊着连接
TRIP_CHAT_DEADLINE_SECONDS = 60
# 一次食谱问答的总预算（秒）；超时会收尾并说明，不会吊着连接
RECIPE_DEADLINE_SECONDS = 35
