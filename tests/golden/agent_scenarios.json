      "expect": {
        "tools": [
          "nope",
          "lookup"
        ],
        "steps": 2,
        "model_calls": 3,
        "second_call_sees_failure": true,
        "final_contains": [
          "丙"
        ]
      }
    },
    {
      "id": "k-missing-required-arg-is-fed-back",
      "note": "required 参数没给：工具要回一条可读失败，模型据此解释，不崩",
